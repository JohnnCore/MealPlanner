generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  PALEO
  GLUTEN_FREE
  LOW_CARB
}

enum IngredientCategory {
  VEGETABLE
  FRUIT
  MEAT
  FISH
  DAIRY
  GRAIN
  LEGUME
  SPICE
  OIL
  OTHER
}

enum UnitType {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  UNIT
  PIECE
  TABLESPOON
  TEASPOON
}

enum RecipeVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ShoppingListRole {
  OWNER
  EDITOR
  VIEWER
}

enum AIGenerationType {
  RECIPE
  MEAL_PLAN
  SHOPPING_OPTIMIZATION
}

enum CategoryColor {
  GREEN
  BLUE
  RED
  ORANGE
  YELLOW
  PURPLE
  INDIGO
  GRAY
}

enum ListColor {
  PRIMARY
  SECONDARY
  GREEN
  BLUE
  PURPLE
  ORANGE
  PINK
  INDIGO
}

//////////////////////////////////////////////////////
// USER & AUTH DOMAIN
//////////////////////////////////////////////////////

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  password        String?
  image           String?

  dietType        DietType @default(OMNIVORE)
  defaultServings Int      @default(1)
  allowLeftovers  Boolean  @default(true)

  notifyPush        Boolean @default(true)
  weeklyDigest      Boolean @default(true)
  allowSharedLists  Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allergies       UserAllergy[]
  pantryItems     PantryItem[]
  createdIngredients Ingredient[]
  recipes         Recipe[]
  mealPlans       MealPlan[]
  shoppingLists       ShoppingList[]
  shoppingCategories  ShoppingCategory[]
  aiGenerations       AIGeneration[]
  favorites           RecipeFavorite[]
  collaborations      ShoppingListCollaborator[]
}

//////////////////////////////////////////////////////
// ALLERGIES
//////////////////////////////////////////////////////

model Allergy {
  id    String @id @default(uuid())
  name  String @unique

  users UserAllergy[]
}

model UserAllergy {
  userId    String
  allergyId String

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergy   Allergy @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([userId, allergyId])
}

//////////////////////////////////////////////////////
// INGREDIENT SYSTEM
//////////////////////////////////////////////////////

model Ingredient {
  id          String  @id @default(uuid())
  name        String
  category    IngredientCategory
  icon        String  @default("🥘")

  calories    Float?
  protein     Float?
  carbs       Float?
  fats        Float?

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  recipeLinks     RecipeIngredient[]
  pantryItems     PantryItem[]
  shoppingItems   ShoppingListItem[]

  @@unique([name, createdByUserId])
  @@index([createdByUserId])
}

//////////////////////////////////////////////////////
// PANTRY
//////////////////////////////////////////////////////

model PantryItem {
  id           String   @id @default(uuid())
  userId       String
  ingredientId String

  quantity     Float
  unit         UnitType
  expiresAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([userId, ingredientId])
  @@index([userId])
  @@index([ingredientId])
}

//////////////////////////////////////////////////////
// RECIPE SYSTEM
//////////////////////////////////////////////////////

model Recipe {
  id             String   @id @default(uuid())
  title          String
  description    String?
  instructions   Json
  servings       Int
  cookTimeMinutes Int             @default(30)
  difficulty     RecipeDifficulty @default(EASY)

  visibility     RecipeVisibility @default(PRIVATE)
  isTemplate     Boolean          @default(false)
  isAIGenerated  Boolean          @default(false)

  authorId       String?
  author         User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  ingredients    RecipeIngredient[]
  mealPlans      MealPlan[]
  favoritedBy    RecipeFavorite[]

  @@index([visibility])
  @@index([authorId])
}

model RecipeIngredient {
  recipeId      String
  ingredientId  String

  quantity      Float
  unit          UnitType

  recipe        Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
}

model RecipeFavorite {
  userId   String
  recipeId String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
}

//////////////////////////////////////////////////////
// MEAL PLANNING
//////////////////////////////////////////////////////

model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String

  date      DateTime
  servings  Int

  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe @relation(fields: [recipeId], references: [id])

  @@index([userId, date])
}

//////////////////////////////////////////////////////
// SHOPPING LISTS (COLLABORATIVE)
//////////////////////////////////////////////////////

model ShoppingList {
  id         String    @id @default(uuid())
  name       String
  color      ListColor @default(PRIMARY)

  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items         ShoppingListItem[]
  collaborators ShoppingListCollaborator[]

  @@index([ownerId])
}

model ShoppingCategory {
  id        String        @id @default(uuid())
  name      String
  icon      String        @default("🛒")
  color     CategoryColor @default(GREEN)
  sortOrder Int           @default(0)

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     ShoppingListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ShoppingListItem {
  id             String   @id @default(uuid())
  shoppingListId String
  categoryId     String
  ingredientId   String?

  name           String
  quantity       Float
  unit           UnitType
  notes          String?
  checked        Boolean  @default(false)
  source         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  category       ShoppingCategory @relation(fields: [categoryId], references: [id])
  ingredient     Ingredient?  @relation(fields: [ingredientId], references: [id])

  @@index([shoppingListId])
  @@index([categoryId])
}

model ShoppingListCollaborator {
  shoppingListId String
  userId         String
  role           ShoppingListRole

  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shoppingListId, userId])
}

//////////////////////////////////////////////////////
// AI GENERATIONS
//////////////////////////////////////////////////////

model AIGeneration {
  id         String   @id @default(uuid())
  userId     String

  type       AIGenerationType
  prompt     Json
  response   Json

  tokensUsed Int?
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
